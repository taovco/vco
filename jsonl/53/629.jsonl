[[0,1340731,0,3,0,3,"2016-10-12T00:59:02","i-am-me","[A]",[],"","What do you think about this quote? How do you \"pay it forward\"?","https://i.sli.mg/BHPf12.jpg","SelfHelpForABetterMe"],[1,6541867,0,1,0,1,"2016-10-12T01:05:05","CanIHazPhD","",[],"<p>I think all persons have a responsibility to better themselves and to not harm others in a direct and percibable way.\r\nEverything else is just one group trying to get something from another group by means of guilt tripping.</p>"],[1,6542192,0,1,0,1,"2016-10-12T01:50:02","drakesdoom","",[],"<p>You can't make the world more successful, and people don't like how you make the average person more successful.</p>\n<p>Eugenics.</p>"]]
