[[0,1361730,0,1,0,1,"2016-10-22T02:04:55","FlaviusHelveticaus","",[],"","The Philippines Just Blew Up Obama's Asia Pivot","https://www.bloomberg.com/view/articles/2016-10-21/the-philippines-just-blew-up-obama-s-asia-pivot","OccidentalEnclave"],[1,6625134,0,0,0,0,"2016-10-22T02:10:09","derram","",[],"<p><a href=\"https://archive.is/Qc9Ai\">https://archive.is/Qc9Ai</a> : \n</p>\n<blockquote>\n<p>The Philippines Just Blew Up Obama's Asia Pivot - Bloomberg View </p>\n</blockquote>\n<p>&quot;What's more, the Obama administration has invested in the country as part of its pivot to Asia.&quot; </p>\n<p>'&quot;And maybe I will also go to Russia to talk to Putin and tell him that there are three of us against the world: China, Philippines and Russia. ' </p>\n<p>'Dan Blumenthal, the director of Asia studies at the American Enterprise Institute, told me Friday that the Obama administration had fumbled. ' </p>\n<p>'Instead, the Obama administration acted as if international law would implement itself. ' </p>\n<p>'The plan was to focus diplomatic and military assets in East Asia to contain a rising China. ' </p>\n<p><a href=\"https://vgy.me/CtXC0x.jpg\">This has been an automated message.</a></p>"]]
