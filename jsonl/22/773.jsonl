[[0,569326,0,9,1,8,"2015-10-07T04:13:07","enotsr22","",[],"","Younger Taylor Swift","https://sli.mg/images/2015/10/06/90e9bb00aa513eccbadc9b470bfb6809.jpg","celebrities"],[1,2735470,0,1,1,0,"2015-10-07T04:16:52","pizza_mine","",[],"<p>Nice boobs, she sings well. I like her songs and and I am way out of her demographic. So what's the problem?</p>"],[1,2735891,0,1,0,1,"2015-10-07T04:55:21","PussySmasherMD","",[],"<p>All pictures of Taylor Swift are from when she was younger.</p>"],[2,2735936,2735891,0,0,0,"2015-10-07T04:59:13","enotsr22","",[],"<p>Every picture is from when it was younger. Except that freaky camera from the Twilight Zone.</p>"],[3,2736365,2735936,1,0,1,"2015-10-07T05:36:01","PussySmasherMD","",[],"<p>I only remember the Goosebumps version from the early '90s.</p>"],[4,2736406,2736365,0,0,0,"2015-10-07T05:39:53","enotsr22","",[],"<p>I remeber that goosebumps episode. I usually watch certain episodes of Twilight Zone when they have those all day marathons on holidays.</p>"],[5,2736620,2736406,1,0,1,"2015-10-07T05:58:04","PussySmasherMD","",[],"<p><a href=\"https://youtu.be/jjrcOIDehZU?t=285\">Found it</a></p>"],[6,2736673,2736620,0,0,0,"2015-10-07T06:02:33","enotsr22","",[],"<p>Great, I can watch Goosbumps until I fall asleep.</p>"]]
