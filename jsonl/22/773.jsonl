[[0,569328,0,3,0,3,"2015-10-07T04:14:24","thoughtpolice","",[],"","WASHINGTON POST | AP INVESTIGATION: Nuclear smugglers sought terrorist buyers [2015-10-07]","https://www.washingtonpost.com/world/europe/ap-investigation-nuclear-smugglers-sought-terrorist-buyers/2015/10/06/6cc0252e-6c72-11e5-91eb-27ad15c2b723_story.html?sid=706F6C69746963616C6E657773","politicalnews"],[1,2735446,0,0,0,0,"2015-10-07T04:14:27","thoughtpolice","",[],"<p>WASHINGTON POST | AP INVESTIGATION: Nuclear smugglers sought terrorist buyers [2015-10-07]</p>\n<p><a href=\"https://archive.is/mpo3F\">https://archive.is/mpo3F</a></p>\n<hr />\n<p><sup>This comment has been posted by the politicalnews bot</sup></p>"]]
[[0,569329,0,5,0,5,"2015-10-07T04:14:31","LostGener","[e]",[],"<p>What gear do you use to handle the outdoors when temps drop? If you have a link, please share it</p>\n<p>Excellent sub-freezing gloves: <a href=\"http://www.amazon.com/gp/product/B008XM9JEA\">http://www.amazon.com/gp/product/B008XM9JEA</a></p>","Favorite winter gear","","Running"],[1,2735873,0,0,0,0,"2015-10-07T04:54:04","SilentMaster","",[],"<p>I wear normal long underwear and these cheap track suits that Walmart sells. I wear stretchy gloves and a stocking cap. I just keep adding layers as it gets colder. Eventually I wear 2 pairs of socks and some neoprene gloves. Honestly it's not anything special, just plenty of layers of clothe and air. It's all generic gear and very cheap.</p>"],[1,2736068,0,0,0,0,"2015-10-07T05:09:52","philomath","",[],"<p>I'm a huge fan of underarmour cold gear. My biggest problem last winter was avoiding ice patches on the road. <a href=\"https://www.underarmour.com/en-ca/mens-ua-heatgear-armour-compression-leggings/pid1257474-334\">Thermal leggings</a>,<a href=\"http://www.cepcompression.com/men/socks/mens-progressive-merino-run-socks\"> compression socks</a>, <a href=\"https://www.underarmour.com/en-ca/cg-infrared-ls-t/pid1248933-101\">cold gear shirt</a>,<a href=\"https://www.underarmour.com/en-ca/ua-escape-cgi-mens/pid1249408-001\"> run gloves</a>, and a <a href=\"https://www.underarmour.com/en-ca/mens-run-beanie/pid1248692-731\">hoodie</a>.</p>"],[1,2736946,0,1,0,1,"2015-10-07T06:26:34","bluntripkin","",[],"<p>i have a stationary bike but i live where its gets colder than moscow 5 months of the year</p>"]]
