[[0,324055,0,55,1,54,"2015-07-21T21:59:54","FrogMantra","",[],"","Worlds longest water slide","http://i.imgur.com/ZhKBJ0W.gifv","gifs"],[1,1240027,0,3,0,3,"2015-07-21T22:04:29","baconFarts","",[],"<p>The water...is brown... D:</p>"],[2,1246593,1240027,3,0,3,"2015-07-22T01:39:41","Skeleman","",[],"<p>Are you sure that's water?</p>"],[3,1246817,1246593,2,0,2,"2015-07-22T01:47:06","baconFarts","",[],"<p>If that turns out to be piss or something, I don't know if I should be impressed or horrified.</p>"],[1,1240126,0,3,0,3,"2015-07-21T22:07:21","user1ne","",[],"<p>That water looks....nasty. </p>"],[1,1240520,0,0,0,0,"2015-07-21T22:19:36","biLLaridoo","",[],"<p><a href=\"http://i.imgur.com/mYJtTVj.gifv\">WATERslide?</a></p>"],[1,1240641,0,0,0,0,"2015-07-21T22:23:52","64tetrahedron","",[],"<p>My god that would be insane... </p>"],[1,1240808,0,0,0,0,"2015-07-21T22:28:53","bab0den","",[],"<p>how many ppl had to pee inside that thing before using it??</p>"],[1,1241029,0,0,0,0,"2015-07-21T22:35:49","TheDon660","",[],"<p>It looks like it's filled with piss lol</p>"],[1,1241118,0,0,0,0,"2015-07-21T22:38:53","iusedtobeonreddit","",[],"<p>how long is it? where is it? looks like fun</p>"],[1,1241492,0,0,0,0,"2015-07-21T22:49:37","Jutack","",[],"<p>Either someone shit themselves on the way down or they have a lot of iron in the water they are using. </p>"],[1,1243207,0,0,0,0,"2015-07-21T23:45:33","zemaR34","",[],"<p>Skidmarked underwear everywhere</p>"],[1,1243608,0,0,0,0,"2015-07-21T23:56:55","Cid","",[],"<p>Badass. Sign me up!</p>"],[1,1244156,0,0,0,0,"2015-07-22T00:15:25","earthman","",[],"<p>Is piss easier to slide on or something? I'm glad the other comments are mentioning this. I would feel like I was in the Twilight Zone if it wasn't mentioned yet..</p>"],[1,1244596,0,0,0,0,"2015-07-22T00:30:22","DownloadedYourCar","",[],"<p>Wow, did anyone notice the slightly muddy water? /s</p>\n<p>It's almost like they made a temporary water slide on the side of a mountain or something.</p>"],[1,1264587,0,0,0,0,"2015-07-22T17:28:40","Outamyhead","",[],"<p>Oh yeah, that yellow line your following, that's from the ten other people that went ahead of you.</p>"],[1,1314649,0,0,0,0,"2015-07-24T08:58:14","wutzurproblem","",[],"<p><a href=\"http://imgur.com/v8LYp4q\">What your ass looks like afterwards.</a></p>"]]
