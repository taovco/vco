[[0,542298,0,48,0,48,"2015-09-26T03:21:07","Caddis","",[],"","They're not wrong","https://veuwer.com/i/36we.jpg","funny"],[1,2589121,0,1,0,1,"2015-09-26T03:30:55","VoutGuy","",[],"<p>You, sir, are right.</p>"],[1,2589676,0,2,0,2,"2015-09-26T04:24:17","JerseyWabbit","",[],"<p>But alcohol will make your problems go away-- at least for awhile.....</p>"],[1,2589850,0,7,0,7,"2015-09-26T04:42:05","Empire_of_the_mind","",[],"<p>They may actually be wrong. Water is hydrating and a high percentage of people are largely dehydrated most of the time, which has an adverse effect on numerous bodily systems.</p>"],[1,2589892,0,4,0,4,"2015-09-26T04:46:20","toats","",[],"<p>&quot;Alcohol: the cause of and solution to all life's problems.&quot; -- <a href=\"/user/homersimpson\">@HomerSimpson</a></p>"],[1,2589920,0,3,0,3,"2015-09-26T04:48:21","100011","",[],"<p>If your problem is drought water will solve it .</p>"],[2,2591259,2589920,1,0,1,"2015-09-26T06:35:02","poodog","",[],"<p>or a fire</p>"],[2,2594689,2589920,1,0,1,"2015-09-26T16:56:17","skittlesforhair","",[],"<p>California agrees.</p>"],[1,2592894,0,0,0,0,"2015-09-26T11:12:48","Kakatoru","",[],"<p>What if one's problem is alcoholism? </p>"]]
