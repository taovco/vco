[[0,1198089,0,5,0,5,"2016-07-28T15:08:40","PolishPandaBear","",[],"<p>Say I want to send a python program to a friend. Is there an easy way of installing the packages required by the program instead of giving him a lecture on how to use pip and a list of modules to download?</p>","Is there an easy way to install required packages.","","Python"],[1,5930342,0,2,0,2,"2016-07-29T11:03:44","el_cordoba","",[],"<p>Check out distutils</p>\n<p><a href=\"https://docs.python.org/3/distutils/introduction.html#distutils-simple-example\">https://docs.python.org/3/distutils/introduction.html#distutils-simple-example</a></p>\n<p>I never had to worry about getting a python project bundled up for someone else, but this should allow for them to do</p>\n<pre><code>python setup.py install\n</code></pre>\n\n<p>They will still need to install the correct version of python.</p>"],[1,6497611,0,0,0,0,"2016-10-06T14:39:05","answermarket","",[],"<p>Distutils / setuptools alternative: <a href=\"http://answer.market/answers/1Ms9Z2ofeCWjUEXNbHcJyEsXkoToUkFhm\">http://answer.market/answers/1Ms9Z2ofeCWjUEXNbHcJyEsXkoToUkFhm</a></p>"]]
