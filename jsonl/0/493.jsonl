[[0,12333,0,7,0,7,"2014-06-27T15:06:00","Bashlet","",[],"","What kind of exchanges would you like to see?","","gifts"],[1,12389,12337,0,0,0,"2014-06-27T20:14:00","Bashlet","",[],"<p>I'm going to make you a moderator so you can become a coordinator!</p>"],[1,12697,12337,0,0,0,"2014-06-28T07:09:00","Eden","",[],"<p>I love these ideas!</p>"],[1,12337,0,1,0,1,"2014-06-27T18:20:00","imakeninetiesreferences","[e]",[],"<p>Music Exchange: home-made mixes of various music or self made music,</p>\n<p>Ugly Sweater Exchange: of course near holiday seasons,</p>\n<p>Book Exchange: who doesn't like a good book? </p>\n<p>Coffee Mug Exchange,</p>\n<p>Pottery Exchange: for the people who make their own or want to try.</p>\n<p>That's all I got, I'm really digging the ugly sweater one.</p>"],[2,12389,12337,0,0,0,"2014-06-27T20:14:00","Bashlet","",[],"<p>I'm going to make you a moderator so you can become a coordinator!</p>"],[2,12697,12337,0,0,0,"2014-06-28T07:09:00","Eden","",[],"<p>I love these ideas!</p>"],[1,14537,0,1,0,1,"2014-07-01T22:34:00","PinkPolkaDots","[e]",[],"<p>Food Exchange (this could be really fun for those who can afford to ship to other countries so we can try different foods)</p>\n<p>Makeup Exchange</p>\n<p>Video Games</p>\n<p>Movies</p>\n<p>Kitchen Gadgets</p>\n<p>Grab Bag/Surprise Box</p>\n<p>and I second the Ugly Sweater one, that sounds fun!</p>"],[2,14569,14537,0,0,0,"2014-07-01T22:57:00","Bashlet","",[],"<p>I love it! I'm so down for all of those.</p>"]]
