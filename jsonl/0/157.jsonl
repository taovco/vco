[[1,3330,3318,1,0,1,"2014-06-12T09:18:00","Domo","",[],"<p>Ye</p>"],[0,3948,0,8,0,8,"2014-06-02T16:58:00","Atko","[e]",[],"<p>Account deletion is now <strong>implemented and live</strong>.</p>\n<p>This signifficantly improves users privacy, and here is why:</p>\n<p>Users can now delete their accounts by accessing their <a href=\"http://whoaverse.com/account/manage\">account management page</a> and submitting the account delete form.</p>\n<p>What this effectively does is following:</p>\n<ol>\n<li>removes all submission voting history</li>\n<li>removes all comment voting history</li>\n<li>removes all comments</li>\n<li>removes all submissions</li>\n</ol>\n<p>Removal is done by overwriting all comments contents and submission texts with the word &quot;deleted&quot; as well as replacing all link submissions with the link to <a href=\"http://whoaverse.com\">http://whoaverse.com</a>.</p>\n<p>Comments made by others on these submissions remain intact.</p>","Account deletion feature implemented.","","voatdev"],[1,3318,0,2,0,2,"2014-06-03T18:03:00","zvrk","",[],"<p>This is awesome! No trace is left, that's amazing. Good job!</p>"],[2,3330,3318,1,0,1,"2014-06-12T09:18:00","Domo","",[],"<p>Ye</p>"],[1,3319,0,2,0,2,"2014-06-03T23:22:00","Anchy","",[],"<p>Nice! :)</p>"],[1,3329,0,1,0,1,"2014-06-12T07:25:00","fuho","[e]",[],"<p>Great!<br />\nEdit: Also testing edit :)</p>"]]
