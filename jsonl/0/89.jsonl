[[0,2233,0,1,0,1,"2014-03-25T20:51:00","Atko","",[],"<p>Markdown has been implemented. This is a first test. <strong>If all goes, well, this part should be bold.</strong> This part should be normal. </p>","Markdown implemented on ForbidMe","","voatdev"],[1,2129,0,1,0,1,"2014-03-25T20:55:00","Atko","",[],"<p>This comment text should be normal. <strong>This should be bold.</strong> This should be normal as well.</p>"],[1,2130,0,1,0,1,"2014-03-25T20:56:00","Atko","",[],"<p>This comment should have <a href=\"http://www.google.com\">a link to Google</a></p>"],[1,2131,0,1,0,1,"2014-03-25T21:32:00","Atko","",[],"<h2 id=\"md-lets-test-a-header-and-a-list\">Let's test a header and a list:</h2>\n<ol>\n<li>Foo</li>\n<li>Bar</li>\n</ol>"],[1,2132,0,1,0,1,"2014-03-25T21:33:00","Atko","",[],"<p>Roses are red, \n</p>\n<p>Violets are blue.</p>"],[1,2133,0,1,0,1,"2014-03-25T21:35:00","Atko","",[],"<p>More info about <strong>Markdown</strong> can be found <a href=\"http:/http://daringfireball.net/projects/markdown/syntax/\">here</a>.</p>"],[2,1875672,2133,0,0,0,"2015-08-17T19:49:17","mukt","",[],"<p><a href=\"/user/atko\">/u/Atko</a>, this link doesn't work anymore. About time we made our own wiki and put Markdown there.</p>"],[1,2134,0,1,0,1,"2014-03-25T21:36:00","Atko","",[],"<p><a href=\"http://i.imgur.com/g2RXrlZ.gif\" title=\"Choppa\">alt text</a></p>"],[1,2135,0,1,0,1,"2014-03-26T10:23:00","Atko","",[],"<p>Aaand another test: <a href=\"http://i.imgur.com/ljoZ8Uw.jpg\">Fat cat is supervising.</a></p>"],[1,2136,0,1,0,1,"2014-03-26T11:03:00","Atko","",[],"<p>super^script^test</p>"],[1,2137,0,1,0,1,"2014-03-26T11:08:00","Atko","",[],"<blockquote>\n<p>quoted text</p>\n</blockquote>"],[1,2138,0,1,0,1,"2014-04-12T11:55:00","Atko","",[],"<p>Testx</p>"],[1,2139,0,1,0,1,"2014-04-12T11:57:00","Atko","",[],"<p>Return redirect test.</p>"]]
