[[0,1724982,0,3,0,3,"2017-03-16T21:18:45","Norm85","",[],"","Wellcome Image Awards winner: Crohn's disease illustration","https://i.imgtc.com/v7cScpL.jpg","pics"],[1,8439626,0,1,0,1,"2017-03-16T21:21:22","Norm85","",[],"<p>Some <a href=\"http://www.abc.net.au/news/2017-03-16/crohns-disease-illustration-wins-science-image-award/8348986\">background information</a>:</p>\n<blockquote>\n<p>An illustration depicting the debilitating effects of Crohn's disease has taken out the top award in science images for 2017.</p>\n<p>This year first place was awarded to an artist who goes by the alter ego Spooky Pooka, for his artwork Stickman - The Vicissitudes of Crohn's.</p>\n<p>The skeleton made of sticks instead of bones represents the transformative nature of Crohn's disease after a flare up and the associated weight loss and fragility.</p>\n<p>Spooky Pooka suffers Crohn's disease, which is caused by an inflammation of the digestive system.</p>\n</blockquote>"]]
