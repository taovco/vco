[[0,1396606,0,6,0,6,"2016-11-08T00:53:27","OhBlindOne","",[],"","Voter ID: John Oliver vs Actual Black People","https://www.youtube.com/watch?v=qfl2JTxr2QU","politics"],[1,6755638,0,1,0,1,"2016-11-08T01:17:40","goatboy","",[],"<p>x-posted to <a href=\"https://voat.co/v/JohnOliverIsEvil\">/v/JohnOliverIsEvil</a></p>\n<p>Seriously, fuck that asshole!</p>"],[2,6756597,6755638,1,0,1,"2016-11-08T03:40:31","NoRagrets","",[],"<p>Oh wow, subbed!</p>"],[1,6755870,0,0,0,0,"2016-11-08T01:55:38","Baconmon","",[],"<p>Well well well, looks like john oliver is racist for assuming black people can't figure any thing out for them selves..<br />\nAnd yeah of course every one already has an ID of some form.. Good fucking luck doing much with out one..</p>"],[1,6756931,0,0,0,0,"2016-11-08T04:33:52","Drenki","",[],"<p>Haha, the paperwork for Obamacare is 1000x more complicated and expensive than what's needed for an ID.</p>\n<p>Checkmate, progressives!</p>"]]
