[[0,1379431,0,3,0,3,"2016-10-31T03:06:40","madazzahattereboot","",[],"<p>He walked up the sidewalk, patted the young boy warmly on the shoulder, and pushed the doorbell. </p>\n<p>Smiling at the lad, he said, &quot;Glad to be of service, my son.&quot; </p>\n<p>Whereupon the young boy replied, &quot;Thanks, Mister. Now run like hell!&quot;</p>","A priest was walking down a neighborhood street when he spied a young boy struggling to reach the doorbell of a large house...","","repostedjokes"],[1,6693848,0,1,0,1,"2016-10-31T03:09:24","Antikaon","",[],"<p>I totally thought this was going to go somewhere else....</p>"]]
