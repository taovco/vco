[[0,1396652,0,1,0,1,"2016-11-08T01:19:16","0x4F","",[],"","Los Angeles Opera faces mass protests from blacks after they cast a white singer in the role of Egyptian pharaoh, Akhnaten","http://www.dailymail.co.uk/news/article-3913746/LA-Opera-Akhnaten-sparks-backlash-casting-white-singer-Egyptian-pharaoh.html","SJWHate"],[1,6755660,0,0,0,0,"2016-11-08T01:20:26","derram","",[],"<p><a href=\"https://archive.is/oNNtW\">https://archive.is/oNNtW</a> : \n</p>\n<blockquote>\n<p>LA Opera Akhnaten show sparks backlash after casting white singer as Egyptian pharaoh | Daily Mail Online </p>\n</blockquote>\n<p>&quot;The LA Opera has been accused of 'whitewashing African history' after casting a white singer to star as an Egyptian pharaoh in the new production of Akhnaten.&quot;, &quot;Some of the protesters dressed up as Egyptian royalty, while others carried signs saying 'our black history matters' and 'Akhenaten was black'.&quot;, &quot;When he was asked about plans for a protest before opening night, Costanzo told the LA Times he hoped to 'honor Akhnaten's legacy'.&quot; </p>\n<p>'Later in the night, three demonstrators arrived on the steps of the Dorothy Chandler Pavilion dressed elaborately as Egyptian royalty. ', &quot;Demonstrators were heard chanting 'Akhnaten was a black man' as they gathered outside the Dorothy Chandler Pavilion for the opening night on Saturday.&quot; </p>\n<p><a href=\"https://vgy.me/zXHtES.jpg\">This has been an automated message.</a></p>"],[1,6756124,0,1,0,1,"2016-11-08T02:37:07","clamhurt_legbeard","",[],"<p>Egyptians are black? That's news to me.</p>"],[1,6758456,0,1,0,1,"2016-11-08T12:24:21","YamaMaya","",[],"<p>Pretty sure they can cast whoever they want.</p>"]]
