[[1,5105961,0,0,0,0,"2016-05-04T20:27:37","Alias_Unknown","",[],"<p>Very rarely will I do that. Generally it's only when I expect there to be a cigarette left and there's not. Then I'll crumple it out of frustration.</p>\n<p>I assume, for those who do more commonly, it's more of a hangover from when soft packs were the norm.</p>"],[1,5106065,0,1,0,1,"2016-05-04T20:37:38","FringeSociety","",[],"<p>I used to.</p>"],[2,5106373,5106065,1,2,-1,"2016-05-04T21:14:21","ashtonward","",[],"<p>did you crumple every pack or just sometimes</p>"],[3,5110922,5106373,1,0,1,"2016-05-05T11:04:14","FringeSociety","",[],"<p>Every one pretty much. No reason to my knowledge. Hulk smash then chuck it.</p>"],[4,5112633,5110922,0,0,0,"2016-05-05T15:23:38","ashtonward","",[],"<p>when did you stop crushing them</p>"],[5,5114148,5112633,1,0,1,"2016-05-05T18:05:04","FringeSociety","",[],"<p>When I quit smoking!</p>"],[6,5114604,5114148,0,0,0,"2016-05-05T18:48:48","ashtonward","",[],"<p>did you crush your first ever pack</p>"]]
