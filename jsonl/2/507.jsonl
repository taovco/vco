[[0,62689,0,3,0,3,"2015-03-12T20:59:14","brackstone","",[],"","Star Citizen client expected to be around 100GB","http://www.pcgamer.com/star-citizen-client-expected-to-be-around-100gb/","videogames"],[1,91635,0,0,0,0,"2015-03-12T20:59:34","brackstone","",[],"<p>I don't know about everyone else but I was a backer for this! Excited it's finally coming to fruition! :D</p>"],[1,92688,0,0,0,0,"2015-03-13T20:25:08","Prudii","",[],"<p>I guess its time to start looking for a larger SSD.</p>"],[2,93882,92688,0,0,0,"2015-03-14T20:48:51","brackstone","",[],"<p>I always get scared to start putting games on my SSD. I'm afraid once I do I'll get addicted and have to buy huge ssds! xD</p>"]]
