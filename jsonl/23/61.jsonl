[[0,576545,0,9,4,5,"2015-10-10T01:08:58","LethalFeline","",[],"","Have a PS4 and a PS+ Subscription? You have access to the Dark Souls 3 Network Stress Test Version over the next three days!","https://store.playstation.com/#!/en-us/games/dark-souls-iii-network-stress-test-ver/cid=UP0700-CUSA03387_00-DARKSOULS3NT0000","gaming"],[1,2774922,0,1,0,1,"2015-10-10T01:17:48","LethalFeline","",[],"<h1>Schedule</h1>\n<h2><strong>Asia (Japan)</strong></h2>\n<p><strong>Test #1</strong> Friday, October 16th, 2015 at 8:00 p.m. to 11:00 p.m. JST</p>\n<p>Friday, October 16th, 2015 at 11:00 a.m. to 2:00 p.m. GMT</p>\n<p><strong>Test #2</strong>\r\nSaturday, October 17th, 2015 at 8:00 p.m. to 11:00 p.m. JST</p>\n<p>Saturday, October 17th, 2015 at 11:00 a.m. to 2:00 p.m. GMT</p>\n<p><strong>Test #3</strong>\r\nSunday, October 18th, 2015 at 8:00 p.m. to 11:00 p.m. JST</p>\n<p>Sunday, October 18th, 2015 at 11:00 a.m. to 2:00 p.m. GMT</p>\n<h2><strong>EMEA/Oceania</strong></h2>\n<p><strong>Test #1</strong> Friday, October 16th, 2015 at 8:00 p.m. to 11:00 p.m. CEST\r\nFriday, October 16th, 2015 at 6:00 p.m. to 9:00 p.m. GMT</p>\n<p><strong>Test #2</strong>\r\nSaturday, October 17th, 2015 at 8:00 p.m. to 11:00 p.m. CEST\r\nSaturday, October 17th, 2015 at 6:00 p.m. to 9:00 p.m. GMT</p>\n<p><strong>Test #3</strong>\r\nSunday, October 18th, 2015 at 8:00 p.m. to 11:00 p.m. CEST\r\nSunday, October 18th, 2015 at 6:00 p.m. to 9:00 p.m. GMT</p>\n<h2><strong>Americas</strong></h2>\n<p><strong>Test #1</strong>\r\nFriday, October 16th, 2015 at 8:00 p.m. to 11:00 p.m. PDT</p>\n<p><strong>Test #2</strong>\r\nSaturday, October 17th, 2015 at 8:00 p.m. to 11:00 p.m. PDT</p>\n<p><strong>Test #3</strong>\r\nSunday, October 18th, 2015 at 8:00 p.m. to 11:00 p.m. PDT</p>\n<hr />\n<p><a href=\"http://cbt.darksouls3.com/en/schedule.html\">More info here</a></p>"],[1,2778050,0,0,0,0,"2015-10-10T05:55:38","LethalFeline","[e]",[],"<p>Welp. Looks like it got taken down. I have it installed. Not sure what will be happening now. Might have just been an accidental launch.</p>"],[2,2787691,2778050,1,0,1,"2015-10-11T05:32:23","Zquareman","",[],"<p>You tried to share it, bro, and that's what's important. You're a decent person.</p>"]]
