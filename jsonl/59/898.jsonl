[[0,1497468,0,1,4,-3,"2016-12-17T16:03:23","DonaldRumsfeld","",[],"","Petition For Full spectrum gender inclusivity for January 2017 National Geographic magazine: PLEASE SUPPORT!!","https://www.change.org/p/shia-labeouf-full-spectrum-gender-inclusivity-for-january-2017-national-geographic-magazine?recruiter=580894964&utm_source=share_petition&utm_medium=email&utm_campaign=share_email_responsive","politics"],[1,7268756,0,0,1,-1,"2016-12-17T16:21:55","DonaldRumsfeld","",[],"<p>Wow. fuck all of you bigots. </p>"],[2,7270367,7268756,0,0,0,"2016-12-17T18:55:10","One-Way_Bus","",[],"<p>Most women in don't even want to join combat arms in the Army. I read a report a couple of months ago that not a single Army noncomissioned officer wanted to reclass into any combat arms. I guess those women are bigots for wanting only men to do the fighting. Lulz!</p>"],[3,7270491,7270367,0,0,0,"2016-12-17T19:06:32","DonaldRumsfeld","",[],"<p><a href=\"http://i1.kym-cdn.com/photos/images/original/000/895/402/0a8.jpg\">did you read the petition?</a></p>"],[4,7270871,7270491,0,0,0,"2016-12-17T19:37:57","One-Way_Bus","",[],"<p>No. I don't read petitions. They're a waste of time.</p>"],[5,7270890,7270871,0,0,0,"2016-12-17T19:39:18","DonaldRumsfeld","",[],"<p>hahahahaha jokes on you pal. this thing is taking off</p>"],[6,7270915,7270890,0,0,0,"2016-12-17T19:41:28","One-Way_Bus","",[],"<p>Nope.</p>"],[1,7269243,0,0,0,0,"2016-12-17T17:13:13","BigFatDaddy","",[],"<p>Women have no place on the battlefield.</p>"],[2,7270518,7269243,0,0,0,"2016-12-17T19:08:28","DonaldRumsfeld","",[],"<p>you sexist. women can do anything men can do. if not BETTER</p>\n<p>source: mia hamm michael jordan </p>"],[3,7270639,7270518,0,0,0,"2016-12-17T19:18:22","BigFatDaddy","",[],"<p>Let me see one write her name in the snow without her hands.</p>"],[4,7270874,7270639,0,0,0,"2016-12-17T19:38:12","DonaldRumsfeld","",[],"<p>THATS EXACTLY WHY WE HAVE SPIRIT COOKING</p>\n<p>stahp it be inclusive</p>"],[5,7270896,7270874,0,0,0,"2016-12-17T19:39:58","BigFatDaddy","",[],"<p>I will not. To hell with 'em.</p>"]]
